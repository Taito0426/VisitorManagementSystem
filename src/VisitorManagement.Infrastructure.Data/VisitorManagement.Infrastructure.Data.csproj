<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VisitorManagement.Core\VisitorManagement.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内部ロジック（SQLバッチ分割等）を単体テストから検証できるようにする -->
    <InternalsVisibleTo Include="VisitorManagement.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      初期スキーマ作成スクリプトを埋め込みリソースとして同梱する。
      デモ版の初回起動時にアプリからスキーマを自動作成するため（設計書 19.2節）、
      db フォルダの正本スクリプトをそのままリンクして二重管理を避ける。
    -->
    <EmbeddedResource Include="..\..\db\01_CreateSchema.sql"
                      LogicalName="VisitorManagement.Infrastructure.Data.Sql.CreateSchema.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
