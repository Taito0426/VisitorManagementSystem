@using System.Security.Claims
<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 来館者記録管理システム</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <div class="app-header__title">来館者記録管理システム</div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="app-header__user">
                <span>@User.FindFirstValue(ClaimTypes.Name) さん</span>
                <form method="post" asp-page="/Logout" class="inline-form">
                    <button type="submit" class="button button--link">ログアウト</button>
                </form>
            </div>
        }
    </header>

    <main class="app-main">
        @RenderBody()
    </main>

    <footer class="app-footer">
        受付端末 / Reception Terminal
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
