<?xml version="1.0" encoding="utf-8"?>
<!--
  管理アプリ（WinForms）の発行設定（設計書 13.1節）。
  .NET 10 では .NET Framework 4.8 と異なり OS 標準搭載のランタイムを利用できないため、
  ランタイム込みの自己完結型（self-contained）として発行し、管理PCへの事前インストールを不要にする。

  実行例) dotnet publish src\VisitorManagement.WinFormsApp -p:PublishProfile=SelfContained -c Release
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PublishDir>bin\Publish\SelfContained\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- WinForms はリフレクションを多用するため、トリミングは行わない -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
</Project>
