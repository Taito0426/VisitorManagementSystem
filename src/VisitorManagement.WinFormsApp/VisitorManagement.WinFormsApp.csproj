<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyTitle>来館者記録管理システム</AssemblyTitle>
    <Product>来館者記録管理システム</Product>
    <Company>Willcode</Company>
    <!--
      設計書 13.1節：管理PCへの .NET 10 Desktop ランタイム事前インストールを不要にするため、
      自己完結型（self-contained）で発行する。発行設定は Properties/PublishProfiles/SelfContained.pubxml に定義し、
      開発時の通常ビルドはランタイム依存のまま高速に保つ。
        dotnet publish -p:PublishProfile=SelfContained
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <!-- System.Security.Cryptography.ProtectedData（DPAPI）は net10.0-windows の共有フレームワークに含まれるため参照不要 -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VisitorManagement.Composition\VisitorManagement.Composition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 導入先ごとの上書き設定。存在する場合のみ出力にコピーする（リポジトリには含めない） -->
    <None Update="appsettings.Local.json" Condition="Exists('appsettings.Local.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
